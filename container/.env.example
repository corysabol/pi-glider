# Copy to `.env` and edit. Used by docker-compose.yml.
# Use absolute paths — Compose does not expand `~` or `$VAR` in `.env` values.
#
# The engagement dir must already contain a seeded `.pi/` agentDir. Seed it with:
#   ./scripts/pi-glider <engagement-dir>   (or `pi-glider <dir>` once installed on PATH)
ENGAGEMENT_DIR=/absolute/path/to/engagement

# Host ports for the in-container Caido sidecar. The container-side ports are fixed
# (5000 = UI/API, 8080 = HTTP(S) proxy); these map them to the host for the operator.
CAIDO_UI_PORT=5000
CAIDO_PROXY_PORT=8080
